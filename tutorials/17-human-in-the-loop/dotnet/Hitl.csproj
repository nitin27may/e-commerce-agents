<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MafV1.Ch17.Hitl</RootNamespace>
    <AssemblyName>Hitl</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      NU1902 = moderate NuGet audit advisory on a transitive OpenTelemetry.Api
      dependency pulled in by Microsoft.Agents.AI.Workflows, with no patched
      release available yet. Same exemption already applied repo-wide in
      agents/dotnet/Directory.Build.props for the identical advisory; scoped
      here since tutorials/dotnet projects don't share that props file.
    -->
    <WarningsNotAsErrors>NU1901;NU1902</WarningsNotAsErrors>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI.Workflows" Version="1.1.0" />
  </ItemGroup>
</Project>
