# ─────────────────────────────────────────────────────────────────────────────
# Minimal configuration — the only variable a first run needs.
#
#   cp .env.minimal .env      then set OPENAI_API_KEY below
#
# Everything else has a working default. The full surface — auth modes, OAuth,
# MCP, telemetry, guardrails, grounding, cost budgets — is in .env.example,
# which is reference material rather than a starting point.
#
# How this file reaches the running services: docs/configuration.md
# ─────────────────────────────────────────────────────────────────────────────

LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-api-key-here

# ── No API key? ──────────────────────────────────────────────────────────────
# Any OpenAI-compatible endpoint works through the same code path. Comment out
# the key above, uncomment these, and run a local model instead. The model must
# support tool calling — see docs/quick-start.md for ones that were verified.
#
# LLM_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# LLM_MODEL=qwen2.5:14b
