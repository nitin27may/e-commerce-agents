{
  "$schema": "https://schema.management.azure.com/schemas/2018-05-01/subscriptionDeploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "openAiLocation": {
      "value": "${AZURE_OPENAI_LOCATION=${AZURE_LOCATION}}"
    },
    "principalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "profile": {
      "value": "${DEPLOY_PROFILE=demo}"
    },
    "chatModelName": {
      "value": "${AZURE_CHAT_MODEL=}"
    },
    "chatModelVersion": {
      "value": "${AZURE_CHAT_MODEL_VERSION=}"
    },
    "deployMiniModel": {
      "value": "${DEPLOY_MINI_MODEL=false}"
    },
    "postgresAdminPassword": {
      "value": "${POSTGRES_ADMIN_PASSWORD}"
    },
    "jwtSecret": {
      "value": "${JWT_SECRET}"
    },
    "agentSharedSecret": {
      "value": "${AGENT_SHARED_SECRET}"
    },
    "openAiApiVersion": {
      "value": "${AZURE_OPENAI_API_VERSION=2025-04-01-preview}"
    },
    "openAiAuth": {
      "value": "${AZURE_OPENAI_AUTH=auto}"
    },
    "imageTag": {
      "value": "${IMAGE_TAG}"
    },
    "publicAccess": {
      "value": "${PUBLIC_ACCESS=restricted}"
    },
    "deployerIp": {
      "value": "${DEPLOYER_IP}"
    },
    "allowedIps": {
      "value": "${ALLOWED_IPS=}"
    },
    "deployAuthServer": {
      "value": "${DEPLOY_AUTH_SERVER=false}"
    },
    "deployMcp": {
      "value": "${DEPLOY_MCP=false}"
    },
    "deployFoundryProject": {
      "value": "${DEPLOY_FOUNDRY_PROJECT=false}"
    },
    "deployGateway": {
      "value": "${DEPLOY_GATEWAY=false}"
    },
    "gatewaySku": {
      "value": "${GATEWAY_SKU=BasicV2}"
    },
    "gatewayPublisherEmail": {
      "value": "${GATEWAY_PUBLISHER_EMAIL=noreply@example.com}"
    },
    "deployPerAppIdentities": {
      "value": "${DEPLOY_PER_APP_IDENTITIES=false}"
    },
    "stack": {
      "value": "${DEPLOY_STACK=python}"
    },
    "imageSource": {
      "value": "${IMAGE_SOURCE=auto}"
    },
    "deployApps": {
      "value": "${DEPLOY_APPS=true}"
    },
    "openAiLocalAuth": {
      "value": "${AZURE_OPENAI_LOCAL_AUTH=auto}"
    },
    "grantDeployerAccess": {
      "value": "${GRANT_DEPLOYER_ACCESS=false}"
    },
    "deployOpenAi": {
      "value": "${DEPLOY_OPENAI=true}"
    },
    "externalLlmProvider": {
      "value": "${EXTERNAL_LLM_PROVIDER=replay}"
    },
    "externalLlmBaseUrl": {
      "value": "${EXTERNAL_LLM_BASE_URL=}"
    },
    "externalLlmModel": {
      "value": "${EXTERNAL_LLM_MODEL=gpt-4.1-mini}"
    },
    "externalLlmApi": {
      "value": "${EXTERNAL_LLM_API=chat_completions}"
    },
    "externalEmbeddingProvider": {
      "value": "${EXTERNAL_EMBEDDING_PROVIDER=replay}"
    },
    "externalLlmApiKey": {
      "value": "${EXTERNAL_LLM_API_KEY=}"
    },
    "a2aIdentityKey": {
      "value": "${A2A_IDENTITY_KEY}"
    },
    "oauthSeedKey": {
      "value": "${OAUTH_SEED_KEY}"
    },
    "authSigningKeyEncryptionKey": {
      "value": "${AUTH_SIGNING_KEY_ENCRYPTION_KEY}"
    },
    "seedStaffPassword": {
      "value": "${SEED_STAFF_PASSWORD}"
    },
    "seedDemoPasswords": {
      "value": "${SEED_DEMO_PASSWORDS=false}"
    }
  }
}
