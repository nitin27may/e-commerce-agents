# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
.venv/
.uv/
uv.lock
# ...but the main Python app's lockfile IS committed so CI installs are
# reproducible and setup-uv's cache key (**/uv.lock) resolves. Same reasoning
# for the tutorials workspace (tutorials/pyproject.toml).
!agents/python/uv.lock
!tutorials/uv.lock
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# .NET / C#
bin/
obj/
*.user
*.suo
*.userprefs
.vs/
.dotnet/
project.lock.json
agents/dotnet/packages/
# Python MCP packages under agents/python/packages/ are intentionally tracked
!agents/python/packages/
TestResults/
[Dd]ebug/
[Rr]elease/
x64/
x86/
*.pdb
*.dll
*.exe
*.nupkg
*.snupkg

# Node
node_modules/
.next/
# Alternate build dirs used by the dual-backend parity run: NEXT_PUBLIC_* is
# inlined at build time, so a frontend pointed at .NET needs its own (see
# web/next.config.ts's NEXT_DIST_DIR note).
.next-*/
out/
articles/

# Playwright
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Environment
.env
.env.local
.env.*.local
!.env.example

# Docker
docker/postgres/data/

# IDE
.vscode/
.idea/
*.swp
*.swo
*.swn

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Tutorial local-run artifacts
# (workflow.mmd / workflow.dot / session.json are intentionally committed in
# some chapters as reference output — don't ignore those. Only ignore clearly
# transient runtime state: checkpoints written during a run.)
tutorials/*/python/checkpoints/
tutorials/*/python/.checkpoints/
tutorials/*/dotnet/checkpoints/
tutorials/*/dotnet/.checkpoints/

# Portfolio screenshot artifacts (local-only, regenerable)
portfolio-screenshots/
web/e2e/portfolio-screenshots.spec.ts
web/e2e/portfolio-chat-flows.spec.ts
web/e2e/portfolio-code-snippets.spec.ts
web/e2e/screenshots/
.claude/scheduled_tasks.lock

# Generated by scripts/build_docs_site.py — the published docs site.
_site_src/
_site/
