# profile: azure-gateway
# @tier: 2
# @summary: Azure OpenAI reached through an AI gateway (API Management) instead of the resource directly.
# @key: AZURE_OPENAI_KEY in .env holding the gateway's subscription key; set AZURE_OPENAI_ENDPOINT to the gateway URL
# @cost: model tokens plus the gateway's own cost
# @dotnet: yes
# @verified: NOT VERIFIED and the gateway is NOT BUILT (milestone M6). Today this is azure-key with another
#   endpoint: no gateway headers (x-agent-name, run ids) are sent yet.
# @evals: live quality and safety suites through the eval CLI, capability check, cost
# @judge: not the model under test. Suggestion only, not calibrated (D-7, M3).
# @judge-env: JUDGE_PROVIDER=openai JUDGE_MODEL=gpt-5.1
LLM_PROVIDER=azure
LLM_BASE_URL=
LLM_TEMPERATURE=
AZURE_OPENAI_ENDPOINT=<set-me>
AZURE_OPENAI_AUTH=key
AZURE_OPENAI_DEPLOYMENT=gpt-5.1
AZURE_OPENAI_API_VERSION=2025-03-01-preview
EMBEDDING_PROVIDER=azure
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small
EMBEDDING_DIM=1536
