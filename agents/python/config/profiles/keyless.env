# profile: keyless
# @tier: 0
# @summary: Recorded model responses, no key and no network. What CI and --no-key use.
# @key: none
# @cost: free
# @dotnet: no (the recorded fixtures are Python request hashes; --no-key is refused with --dotnet)
# @verified: every pull request (replay evals, tutorials keyless path, compose no-key overlay in CI)
# @evals: replay regression, detector recall. Not a quality measure: only prompts that were recorded answer.
# @judge: none (replay calls no model)
# @judge-env:
LLM_PROVIDER=replay
LLM_BASE_URL=
LLM_API=responses
EMBEDDING_PROVIDER=replay
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
