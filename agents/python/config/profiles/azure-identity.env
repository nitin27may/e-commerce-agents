# profile: azure-identity
# @tier: 1
# @summary: Azure OpenAI with a Microsoft Entra token (no key). Locally DefaultAzureCredential uses `az login`.
# @key: none in .env besides AZURE_OPENAI_ENDPOINT; needs the "Cognitive Services OpenAI User" role on the resource
# @cost: pay per token on your subscription
# @dotnet: yes
# @verified: token wiring by stubbed-credential tests on both stacks. Never exercised against a real Entra
#   token or a real resource from this repo.
# @evals: live quality and safety suites through the eval CLI, capability check, cost; replay gate not applicable
# @judge: not the model under test. Suggestion only, not calibrated (D-7, M3).
# @judge-env: JUDGE_PROVIDER=openai JUDGE_MODEL=gpt-5.1
LLM_PROVIDER=azure
LLM_BASE_URL=
LLM_TEMPERATURE=
AZURE_OPENAI_AUTH=identity
AZURE_OPENAI_DEPLOYMENT=gpt-5.1
AZURE_OPENAI_API_VERSION=2025-03-01-preview
EMBEDDING_PROVIDER=azure
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small
EMBEDDING_DIM=1536
