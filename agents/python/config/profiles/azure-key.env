# profile: azure-key
# @tier: 1
# @summary: Azure OpenAI with an API key, Chat Completions, an embedding deployment on the same resource.
# @key: AZURE_OPENAI_ENDPOINT and AZURE_OPENAI_KEY in .env; deployments named gpt-5.1 and text-embedding-3-small
#   (override AZURE_OPENAI_DEPLOYMENT / AZURE_EMBEDDING_DEPLOYMENT if yours are named differently)
# @cost: pay per token on your subscription
# @dotnet: yes
# @verified: the 102 replay fixtures were recorded through Azure on gpt-4.1. The capability probes passed tool
#   calling, streaming and tool results on gpt-5.2, gpt-5.4, gpt-5.4-mini and the gpt-5.6 deployments at API
#   version 2025-01-01-preview (agents/python/evals/provider-results/). gpt-5.1 and the API version below were
#   not probed, and the gpt-5.6 deployments rejected temperature 0.2, which LLM_TEMPERATURE= below avoids.
# @evals: live quality and safety suites through the eval CLI, capability check, cost; replay gate not applicable
# @judge: not the model under test; gpt-5.4-mini was the best judge under the calibration rule (evals/judge_calibration/README.md, 2026-11-24).
# @judge-env: JUDGE_PROVIDER=azure JUDGE_MODEL=gpt-5.4-mini
LLM_PROVIDER=azure
LLM_BASE_URL=
LLM_TEMPERATURE=
AZURE_OPENAI_AUTH=key
AZURE_OPENAI_DEPLOYMENT=gpt-5.1
AZURE_OPENAI_API_VERSION=2025-03-01-preview
EMBEDDING_PROVIDER=azure
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small
EMBEDDING_DIM=1536
