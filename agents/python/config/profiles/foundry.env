# profile: foundry
# @tier: 2
# @summary: Models deployed in a Microsoft Foundry resource, called with Entra identity.
# @key: no key; set AZURE_OPENAI_ENDPOINT to the Foundry resource endpoint. Needs the "Cognitive Services OpenAI
#   User" role and an `az login` locally (or a managed identity when hosted)
# @cost: pay per token on your subscription
# @dotnet: yes
# @verified: NOT VERIFIED. Same wire as azure-identity. The Foundry project, evaluations, tracing and
#   hosted agents are NOT BUILT (milestones M5 to M7); nothing here talks to a Foundry project API.
# @evals: live quality and safety suites through the eval CLI, capability check, cost
# @judge: not the model under test. Suggestion only, not calibrated (D-7, M3).
# @judge-env: JUDGE_PROVIDER=openai JUDGE_MODEL=gpt-5.1
LLM_PROVIDER=azure
LLM_BASE_URL=
LLM_TEMPERATURE=
AZURE_OPENAI_ENDPOINT=<set-me>
AZURE_OPENAI_AUTH=identity
AZURE_OPENAI_DEPLOYMENT=gpt-5.1
AZURE_OPENAI_API_VERSION=2025-03-01-preview
EMBEDDING_PROVIDER=azure
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small
EMBEDDING_DIM=1536
