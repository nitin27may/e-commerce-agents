  "specialist": {
    "GET /.well-known/agent-card.json": {
      "credential": "none",
      "note": "Public card; lists only tools the customer role may call."
    },
    "GET /docs": {
      "credential": "inter_agent",
      "note": "FastAPI default, behind the middleware: needs a credential."
    },
    "GET /docs/oauth2-redirect": {
      "credential": "inter_agent",
      "note": "FastAPI default, behind the middleware: needs a credential."
    },
    "GET /health": {
      "credential": "none",
      "note": "Liveness."
    },
    "GET /openapi.json": {
      "credential": "inter_agent",
      "note": "FastAPI default, behind the middleware: needs a credential."
    },
    "GET /ready": {
      "credential": "none",
      "note": "Readiness; cached, no detail beyond status."
    },
    "GET /redoc": {
      "credential": "inter_agent",
      "note": "FastAPI default, behind the middleware: needs a credential."
    },
    "POST /a2a/v1": {
      "credential": "inter_agent",
      "note": "A2A 1.0 JSON-RPC. Same credentials and forwarded identity as the legacy pair."
    },
    "POST /message:send": {
      "credential": "inter_agent",
      "note": "Legacy A2A. Needs a credential plus the forwarded user identity (headers or X-User-Context)."
    },
    "POST /message:stream": {
      "credential": "inter_agent",
      "note": "Legacy A2A SSE. Same as /message:send."
    }
  },
  "auth_server": {
    "GET /.well-known/jwks.json": {
      "credential": "none",
      "note": "Public keys only: the active key plus rotated-out keys inside their window."
    },
    "GET /.well-known/oauth-authorization-server": {
      "credential": "none",
      "note": "RFC 8414 metadata."
    },
    "GET /health": {
      "credential": "none"
    },
    "POST /oauth/register": {
      "credential": "service_token_register",
      "note": "403 unless AUTH_ALLOW_DYNAMIC_REGISTRATION; then a bearer token from this auth-server with scope client:register."
    },
    "POST /oauth/token": {
      "credential": "client_credentials",
      "note": "client_secret_basic or client_secret_post; the password grant also needs the user's password, the refresh grant a refresh token."
    }
  },
  "mcp_auth_on": {
    "ANY /mcp": {
      "credential": "oauth_service_token"
    },
    "GET /.well-known/oauth-protected-resource/mcp": {
      "credential": "none"
    }
  },
  "mcp_auth_off": {
    "ANY /mcp": {
      "credential": "none",
      "note": "MCP_AUTH_ENABLED is false: the endpoint is open to anything that can reach it."
    }
  }
}
