<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <!--
      NU1901/NU1902 = low/moderate NuGet audit advisories. We do NOT fail the
      build on these because some flagged transitive packages (e.g.
      OpenTelemetry.Instrumentation.AspNetCore, GHSA-vh2m-22xx-q94f) have no
      patched release available yet. High/critical advisories (NU1903/NU1904)
      remain build-breaking errors. NU5104 = pre-release dependency notice.
    -->
    <WarningsNotAsErrors>NU5104;NU1901;NU1902</WarningsNotAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!--
      Kept in sync with agents/python/pyproject.toml and web/package.json by
      scripts/bump_version.py. release.yml's version-check job fails the release
      if the git tag and these disagree.
    -->
    <VersionPrefix>1.2.0</VersionPrefix>
    <Authors>Nitin Kumar Singh</Authors>
    <Copyright>Copyright (c) $([System.DateTime]::Now.Year)</Copyright>
    <RepositoryUrl>https://github.com/nitin27may/e-commerce-agents</RepositoryUrl>
  </PropertyGroup>

  <!--
    All projects use central package management via Directory.Packages.props at the repo root (one level up).
    Project-level <PackageReference> entries omit the Version attribute.
  -->
</Project>
