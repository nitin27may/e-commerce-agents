<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <IsPackable>false</IsPackable>
    <!--
      This is a shared fixtures library consumed by the *.Tests projects, not a
      test suite itself. Mark it so `dotnet test <sln>` does not launch a
      testhost against it — doing so aborts the whole run on CI because the
      fixtures' transitive Azure.AI.OpenAI.dll isn't deployed to its output.
    -->
    <IsTestProject>false</IsTestProject>
    <Description>
      Shared test fixtures for every ECommerceAgents test project:
      - PostgresFixture: one Postgres testcontainer per test session, schema-migrated from docker/postgres/init.sql
      - FakeChatClient: deterministic IChatClient for LLM-less unit tests
      - AgentRegistryFixture: stub A2A endpoints for cross-specialist testing
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ECommerceAgents.Shared\ECommerceAgents.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Moq" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>
