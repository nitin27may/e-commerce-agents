<Project>
  <!--
    Central Package Management for ECommerceAgents .NET port.
    All version numbers live here; individual csproj files reference only <PackageReference Include="..." />.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Microsoft Agent Framework">
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.28.0" />
    <PackageVersion Include="Microsoft.Agents.AI.OpenAI" Version="1.28.0" />
    <!-- Real WorkflowBuilder graphs (issue #17) — same version line as
         Microsoft.Agents.AI above; the package's own nuspec tracks it in
         lockstep (verified: 1.1.0 Workflows -> 1.1.0 core), so pinning both
         at 1.28.0 keeps them aligned. -->
    <PackageVersion Include="Microsoft.Agents.AI.Workflows" Version="1.28.0" />
    <PackageVersion Include="Azure.AI.OpenAI" Version="2.9.0-beta.1" />
    <PackageVersion Include="Anthropic" Version="13.13.0" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
  </ItemGroup>

  <ItemGroup Label="A2A 1.0 (spec 1.0, JSON-RPC binding)">
    <!-- The official A2A .NET SDK (a2aproject/a2a-dotnet). Both are PREVIEW releases, pinned exactly
         (plan decision B-d6) and grouped in Dependabot with the other protocol packages. Server and
         client share the A2A package; A2A.AspNetCore supplies the JSON-RPC endpoint and the
         A2A-Extensions negotiation. -->
    <PackageVersion Include="A2A" Version="1.0.0-preview4" />
    <PackageVersion Include="A2A.AspNetCore" Version="1.0.0-preview4" />
  </ItemGroup>

  <ItemGroup Label="ASP.NET Core + hosting">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="MCP">
    <!-- Official C# MCP SDK, ASP.NET Core streamable-HTTP transport (real
         JSON-RPC, not the REST imitation this replaced; see issue #13). -->
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup Label="Data">
    <PackageVersion Include="Npgsql" Version="11.0.0" />
    <PackageVersion Include="Dapper" Version="2.1.100" />
    <PackageVersion Include="StackExchange.Redis" Version="3.4.35" />
  </ItemGroup>

  <ItemGroup Label="Auth">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
    <PackageVersion Include="BCrypt.Net-Next" Version="4.2.1" />
  </ItemGroup>

  <ItemGroup Label="Observability">
    <!--
      Bumped past the moderate advisories previously pinned around
      (GHSA-g94r-2vxg-569j, GHSA-4625-4j76-fww9, GHSA-vh2m-22xx-q94f) now
      that patched Instrumentation.* releases exist. 1.13.x's breaking change
      (removal of OpenTelemetry.Trace.Status) doesn't affect this codebase —
      grep confirms nothing here references OpenTelemetry.Trace.Status,
      Activity.SetStatus, or ActivityStatusCode.
    -->
    <PackageVersion Include="OpenTelemetry" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageVersion Include="Npgsql.OpenTelemetry" Version="11.0.0" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup Label="Resilience">
    <PackageVersion Include="Polly" Version="8.9.1" />
  </ItemGroup>

  <ItemGroup Label="Config + YAML">
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.15" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="FluentAssertions" Version="8.11.0" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.17.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.1" />
  </ItemGroup>
  <ItemGroup Label="Aspire AppHost (alternative to docker compose; docs/deployment.md)">
    <!-- Aspire 17.x. One version for every Aspire.Hosting package; bump them together. The dashboard image pinned in
         the compose files stays on its own tag: the AppHost ships its own dashboard. -->
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.Dotnet" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.Redis" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.Python" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="17.0.0" />
  </ItemGroup>
</Project>
