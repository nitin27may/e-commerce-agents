# ============================================================
# E-Commerce Agents — Environment Configuration
# ============================================================
# Copy to .env and configure your LLM provider:
#   cp .env.example .env
#
# Three LLM providers are supported. Uncomment ONE section below.
# All agents, tools, and embedding generation use the same provider.
# ============================================================


# ── LLM Provider ─────────────────────────────────────────────
# Set to "openai", "azure", or "replay" — controls ALL LLM and embedding calls
LLM_PROVIDER=openai


# ┌────────────────────────────────────────────────────────────┐
# │  OPTION A: OpenAI (or any OpenAI-compatible endpoint)       │
# │  Set LLM_PROVIDER=openai and fill in below                 │
# └────────────────────────────────────────────────────────────┘

OPENAI_API_KEY=sk-your-openai-api-key-here
# Model names date fast. Set this to a current chat model from your provider's
# live list — https://developers.openai.com/api/docs/models — rather than
# treating the value below as a recommendation. It is a known-working floor.
LLM_MODEL=gpt-4.1
EMBEDDING_MODEL=text-embedding-3-small

# Sampling temperature for every agent run (default 0.2). Set it EMPTY to send no temperature at all:
# gpt-5.x models reject the parameter. Unset is not the same as empty.
# LLM_TEMPERATURE=0.2

# Database connection pool bounds per process. Python defaults 5/20; .NET leaves Npgsql's 0/100 unless
# set. Lower them on a managed Postgres, where every service holds its own pool against max_connections.
# DB_POOL_MIN_SIZE=5
# DB_POOL_MAX_SIZE=20

# Embeddings can be configured apart from the chat provider. All optional: with none of these set,
# embeddings follow LLM_PROVIDER exactly as before (text-embedding-3-small, 1536 dimensions).
# EMBEDDING_PROVIDER=          # openai | azure | openai_compatible | replay  (empty = follow LLM_PROVIDER)
# EMBEDDING_BASE_URL=          # e.g. http://localhost:11434/v1 for Ollama (required for openai_compatible)
# EMBEDDING_API_KEY=           # replaces OPENAI_API_KEY for embeddings only. With EMBEDDING_BASE_URL set the chat
#                              # key is NEVER sent to that host: it gets this key, or a placeholder if unset
# EMBEDDING_DIM=1536           # must equal the vector(N) columns; to change it run
#                              #   uv run --project agents/python python scripts/reset_embeddings.py --dim N
#                              # (deletes stored embeddings; the agents refuse to start on a mismatch)
# Local example (documented, not exercised in CI):
#   EMBEDDING_PROVIDER=openai_compatible  EMBEDDING_BASE_URL=http://localhost:11434/v1
#   EMBEDDING_MODEL=nomic-embed-text  EMBEDDING_DIM=768

# Optional: point OpenAIChatClient at an OpenAI-compatible endpoint other
# than api.openai.com — Ollama, OpenRouter, vLLM, LM Studio,
# etc. Only takes effect when LLM_PROVIDER=openai. Leave unset to use OpenAI
# directly.
#
# Ollama is the free path — fully local, zero cost, zero network, no account.
# Start it with a raised context window (the 4K default silently truncates
# agent loops):  OLLAMA_CONTEXT_LENGTH=64000 ollama serve
#   LLM_BASE_URL=http://localhost:11434/v1
#   OPENAI_API_KEY=ollama  (any non-empty string — Ollama doesn't check it)
#   LLM_MODEL=qwen2.5:14b   (see the Gotcha below before picking a model)
#
# LM Studio — same idea, load a model in LM Studio's local server first:
#   LLM_BASE_URL=http://localhost:1234/v1
#   OPENAI_API_KEY=lm-studio  (any non-empty string)
#   LLM_MODEL=<the model identifier shown in LM Studio's server tab>
#
# Gotcha: every specialist agent in this repo is tool-calling-heavy (the
# @tool decorator is how they read the database at all). Many small/
# quantized local models advertise OpenAI-compatible chat completions but
# have unreliable or absent function-calling support — the agent won't
# error, it will just silently stop calling tools and answer from
# (fabricated) memory instead. Measured 2026-08-21 on a 2-tool multi-turn
# loop, qwen2.5:14b, gemma4:12b and qwen3.5:9b all pass. qwen2.5:14b is
# the recommended default: it emits no reasoning trace, so it is ~6x faster
# and cannot spend its whole output budget thinking and return empty content
# than a generic small chat model. If responses stop mentioning real
# product/order data, that's the first thing to check — not a bug in this
# repo's code.
#
# OpenRouter / vLLM: same LLM_BASE_URL mechanism, no code changes needed —
# point it at your OpenRouter base URL or self-hosted vLLM server the same
# way as the examples above.
#
# LLM_API picks which OpenAI wire API the Python stack speaks (the .NET stack
# always uses Chat Completions and ignores it):
#   responses         (default) POST /responses — what api.openai.com expects
#   chat_completions  POST /chat/completions — use this for endpoints that have
#                     no /responses route: Gemini's OpenAI-compatible endpoint
#                     (LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/)
#                     and some vLLM / Ollama versions. A 404 on /responses is
#                     the symptom.
# Only takes effect when LLM_PROVIDER=openai (azure is always Chat Completions).
# LLM_API=responses
# LLM_BASE_URL=


# ┌────────────────────────────────────────────────────────────┐
# │  OPTION B: Azure OpenAI                                    │
# │  Set LLM_PROVIDER=azure and fill in below                  │
# └────────────────────────────────────────────────────────────┘

# LLM_PROVIDER=azure
AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_KEY is the repo-native name. AZURE_OPENAI_API_KEY (MAF-docs
# style) is accepted as an alias — set either one.
AZURE_OPENAI_KEY=
# AZURE_OPENAI_DEPLOYMENT is the repo-native name. AZURE_OPENAI_DEPLOYMENT_NAME
# is accepted as an alias.
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_API_VERSION=2025-03-01-preview
# key (default) | identity. identity sends a Microsoft Entra token and no key (AZURE_OPENAI_KEY is then not
# needed); it requires a managed identity with the "Cognitive Services OpenAI User" role on the resource.
# AZURE_CLIENT_ID selects a user-assigned identity; empty uses DefaultAzureCredential.
# AZURE_OPENAI_AUTH=key
# AZURE_CLIENT_ID=

# Azure embedding deployment (uses EMBEDDING_MODEL name if not set)
AZURE_EMBEDDING_DEPLOYMENT=


# ┌────────────────────────────────────────────────────────────┐
# │  OPTION C: Replay — no credentials, no network              │
# │  Set LLM_PROVIDER=replay. Plays back recorded fixtures.     │
# │  See shared/replay_client.py / tutorials/_shared/replay_client.py │
# └────────────────────────────────────────────────────────────┘

# LLM_PROVIDER=replay
# Directory of recorded request/response fixtures, keyed by request hash.
# REPLAY_FIXTURES_DIR=evals/fixtures/replay
# Set to true to record a real call (via REPLAY_RECORD_PROVIDER) whenever a
# fixture is missing, instead of raising. Needs real credentials for
# whichever provider REPLAY_RECORD_PROVIDER names.
# RECORD=false
# REPLAY_RECORD_PROVIDER=openai


# ┌────────────────────────────────────────────────────────────┐
# │  OPTION D: Anthropic (Claude) — Python and .NET stacks      │
# │  Wired and stub-tested on both; never run against the live  │
# │  API (a smoke run with a real key is still owed).           │
# └────────────────────────────────────────────────────────────┘

# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5   # others: claude-opus-5-5, claude-haiku-5-5 (LLM_MODEL is ignored)
# Anthropic has no embeddings API: set EMBEDDING_PROVIDER (see docs/configuration.md) or semantic
# search falls back to full-text (the stack still starts and logs what is missing).


# ── Database ─────────────────────────────────────────────────
# Use @localhost here. docker-compose.yml hardcodes its own DATABASE_URL
# (with @db) for in-container services, so this value is only consumed
# by host-side scripts: evals, seeders, and local REPL sessions.
POSTGRES_DB=ecommerce_agents
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce_secret
DATABASE_URL=postgresql://ecommerce:ecommerce_secret@localhost:5432/ecommerce_agents


# ── Redis ────────────────────────────────────────────────────
# Same as DATABASE_URL — host-side scripts use localhost, containers use redis.
REDIS_URL=redis://localhost:6379


# ── Auth ─────────────────────────────────────────────────────
# Generate secrets: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-generate-a-random-256-bit-key
AGENT_SHARED_SECRET=agent-internal-shared-secret

# ── OAuth2 (optional; self-hosted, no external IdP) ───────────
# AUTH_MODE=local (default) keeps the JWT_SECRET/AGENT_SHARED_SECRET
# behavior above unchanged. Set AUTH_MODE=oauth to route user login and
# A2A/MCP auth through the self-hosted auth-server instead — start it
# with `docker compose --profile agents up auth-server`. Nothing here
# requires internet access or an account with any identity provider.
AUTH_MODE=local
AUTH_SERVER_ISSUER=http://localhost:8090
AUTH_SERVER_JWKS_URL=http://localhost:8090/.well-known/jwks.json
AUTH_SERVER_TOKEN_URL=http://localhost:8090/oauth/token
AUTH_ACCESS_TOKEN_TTL=3600
AUTH_REFRESH_TOKEN_TTL=604800
AUTH_JWKS_CACHE_TTL=900
AUTH_RSA_KEY_SIZE=2048
# Encrypts the auth-server's private signing key at rest. Required outside
# development when AUTH_MODE=oauth; generate with the command above.
AUTH_SIGNING_KEY_ENCRYPTION_KEY=
# Signing-key rotation (AUTH_MODE=oauth): seconds a rotated-out key stays in the
# JWKS. 0 = derive it as AUTH_ACCESS_TOKEN_TTL + 300 (clock skew), which is what
# you want unless you lengthen the access-token TTL on running tokens.
# Rotate with: uv run --project agents/python python -m scripts.rotate_signing_key
AUTH_KEY_RETIRE_AFTER_SECONDS=0
# Per-service client identity for the client-credentials grant. Each
# service defaults OAUTH_CLIENT_ID to its own name; leave OAUTH_CLIENT_SECRET
# blank in dev to derive it from OAUTH_SEED_KEY, or set an explicit secret
# per service in production.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_SEED_KEY=dev-oauth-seed-change-me
AUTH_ORCH_AUDIENCE=ecommerce-orchestrator
AUTH_AGENT_AUDIENCE=ecommerce-agents
# Reject (not just log) an inter-agent call whose forwarded X-User-Email/
# X-User-Role headers look spoofed. Checked in both local and oauth modes.
GUARDRAILS_STRICT_IDENTITY=false
# RFC 7591 dynamic client registration (POST /oauth/register), off by
# default — the client registry is otherwise fixed/seeded. Even when true,
# registering still requires a bearer token scoped client:register (see the
# seeded "auth-admin" client in scripts/seed.py).
AUTH_ALLOW_DYNAMIC_REGISTRATION=false
AUTH_SERVER_AUDIENCE=ecommerce-auth-server

# MCP resource-server auth (independent of MCP_ENABLED below).
MCP_AUTH_ENABLED=false
MCP_PRODUCT_AUDIENCE=mcp-product
MCP_INVENTORY_AUDIENCE=mcp-inventory
MCP_PRODUCT_REQUIRED_SCOPE=mcp:product
MCP_INVENTORY_REQUIRED_SCOPE=mcp:inventory
MCP_PRODUCT_RESOURCE_URL=http://mcp-product:9000/mcp
MCP_INVENTORY_RESOURCE_URL=http://mcp-inventory:9001/mcp


# ── Cost budget (per-run LLM spend ceiling) ─────────────────
# observe (default): estimate and log every run's cost, count a turn that is past the
#   ceiling as cost_budget.would_block, never refuse. enforce: refuse the next LLM turn
#   once a run's estimated cost passes the ceiling. off: not attached.
# 0.50 USD is a demo default, sized to catch a runaway loop, not a normal turn. Leave
# COST_BUDGET_MODE=observe until cost_budget.would_block shows it would not bite real traffic.
COST_BUDGET_MODE=observe
COST_BUDGET_USD_PER_RUN=0.50

# ── Telemetry (OpenTelemetry → .NET Aspire Dashboard) ────────
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://aspire:18889
OTEL_SERVICE_NAME=ecommerce.orchestrator
# Prompt/completion text in GenAI spans. Off by default (PII); see docs/telemetry.md.
# OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false

# ── Edge: CORS and rate limits (docs/configuration.md) ────────
# CORS_ALLOWED_ORIGINS=http://localhost:3000
# RATE_LIMIT_AUTH_MAX_REQUESTS=10        # per (address, email) for login/signup, per user for refresh
# RATE_LIMIT_AUTH_IP_MAX_REQUESTS=300    # address-only ceiling; raise for local Playwright runs
# RATE_LIMIT_TRUSTED_PROXY_HOPS=1        # proxies appending to X-Forwarded-For, orchestrator side
# WEB_TRUSTED_PROXY_HOPS=0               # same, frontend side; leave 0 unless an ingress sits in front

# ── Langfuse (optional parallel OTel sink) ────────────────────
# Get keys from https://cloud.langfuse.com → Project Settings
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com


# ── MCP Integration (optional) ───────────────────────────────
# Start MCP servers first: docker compose --profile mcp up
# then set MCP_ENABLED=true and restart the specialist agents.
MCP_ENABLED=false
MCP_PRODUCT_SERVER_URL=http://mcp-product:9000/mcp
MCP_INVENTORY_SERVER_URL=http://mcp-inventory:9001/mcp


# ── General ──────────────────────────────────────────────────
ENVIRONMENT=development


# ── Agent Registry ───────────────────────────────────────────
# Internal Docker network URLs for inter-agent A2A communication
AGENT_REGISTRY={"product-discovery":"http://product-discovery:8081","order-management":"http://order-management:8082","pricing-promotions":"http://pricing-promotions:8083","review-sentiment":"http://review-sentiment:8084","inventory-fulfillment":"http://inventory-fulfillment:8085"}

# Which wire the orchestrator (and the handoff mesh) speaks to a specialist, on either stack:
#   legacy  the original POST /message:send + /message:stream pair (default)
#   a2a     A2A 1.0 JSON-RPC at /a2a/v1, through the official SDK client (a Python or a .NET specialist)
# Every specialist, Python and .NET, serves both. See docs/a2a.md.
A2A_TRANSPORT=legacy
# The origin a specialist advertises in its agent card. Leave empty to derive it from the request;
# set it behind a proxy that terminates TLS or rewrites the Host header. It must name the same origin
# AGENT_REGISTRY uses, or a calling client refuses the card.
A2A_PUBLIC_BASE_URL=
# Running A2A tasks one specialist process accepts, in total and per forwarded user. Over either, a new
# message is refused (never queued).
A2A_MAX_ACTIVE_TASKS=32
A2A_MAX_ACTIVE_TASKS_PER_CALLER=8

# How a specialist learns which user an inter-agent call is for (B-14, docs/a2a.md):
#   headers  the forwarded X-User-Email / X-User-Role / X-Session-Id, trusted on the strength of the shared secret
#   both     (default) the orchestrator sends a signed, short-lived X-User-Context token AND the headers; a specialist
#            verifies the token when there is one (a header that contradicts it is refused) and falls back to the
#            headers when there is none, so a mixed or half-upgraded deployment keeps working
#   token    only a verified token; the headers are not read. The target once every deployment is upgraded.
A2A_IDENTITY=both
# The token's signing key (HKDF-derived). Empty uses AGENT_SHARED_SECRET. Holding X-Agent-Secret alone stops letting a
# caller choose its user ONLY with A2A_IDENTITY=token AND this set to a value DIFFERENT from the shared secret (under
# `both` a caller can omit the token and send forged X-User-* headers; a startup warning fires for `token` without a
# distinct key). Identical on the orchestrator and every specialist, on both stacks. Generate: python -c "import secrets; print(secrets.token_hex(32))"
A2A_IDENTITY_KEY=
# Token lifetime in seconds (30 to 900). A specialist also refuses any token living longer than 15 minutes.
A2A_IDENTITY_TTL_SECONDS=300


# ── Frontend ─────────────────────────────────────────────────
# Where the frontend's server-side /api/* proxy forwards to. Server-side, not
# NEXT_PUBLIC_*: the browser only ever calls the frontend's own origin, so this
# is read at runtime and never compiled into the bundle. Inside compose that
# makes it a service name; on the host running `pnpm dev` it is localhost.
ORCHESTRATOR_URL=http://localhost:8080


# ── MAF v1 feature flags (optional — safe defaults keep current behavior) ──
# These back the Phase 7 refactor of the live app into MAF-native idioms.
# Uncomment a line only when you want to opt out of the new default.

# MAF_SESSION_BACKEND=postgres     # postgres | file | memory
# MAF_SESSION_DIR=./.sessions
# MAF_CHECKPOINT_BACKEND=postgres  # postgres | file | memory
# MAF_CHECKPOINT_DIR=./.checkpoints
# RETURN_HITL_THRESHOLD=500        # USD above which return/replace pauses for human approval
# RETURN_LIFECYCLE_ENABLED=false    # approved returns wait for the carrier's scan (needs the outbox worker); see docs/return-lifecycle.md
# RETURN_SCAN_TIMEOUT_DAYS=14
# RETURN_INSPECTION_TIMEOUT_DAYS=7  # an uninspected return nudges the admins after this; it never denies the customer
# HANDOFF_AUTONOMOUS_MODE=true     # true → specialists auto-respond; false → surface handoff events
# HANDOFF_MAX_TURNS=3              # autonomous-mode ceiling for the triage agent. Honoured
#                                  # by both stacks.
#                                  # MAF defaults to 50; that is how a triage agent
#                                  # that cannot hand off produces a 23k-char monologue.
# WORKFLOW_VISUALIZATION_ON_BUILD=false  # true → CI regenerates docs/workflows/*.mmd and fails on drift

# --- History compaction (B-15) --------------------------------------------
# Keep only the last N message groups (a user turn with its assistant/tool messages) of the conversation history
# a specialist rehydrates and the orchestrator forwards. 0 = off (default). Both stacks.
HISTORY_COMPACTION_KEEP_LAST_GROUPS=0

# --- Event autonomy (#94) -------------------------------------------------
# The outbox worker acts on events inside the budgets in agents/python/config/policies/autonomy.yaml. Off by default.
AUTONOMY_ENABLED=false
# The admin-only demo event simulator (needs AUTONOMY_ENABLED too).
AUTONOMY_SIMULATOR_ENABLED=false
# AUTONOMY_POLICY_PATH=

# --- .NET approval timeouts (NET-36) --------------------------------------
# .NET orchestrator only: the hosted service that applies an SLA timeout to a paused return the .NET stack opened.
# The Python worker skips those rows. false = they wait. Also honours the OUTBOX_* settings the Python worker reads.
DOTNET_TIMEOUT_WORKER_ENABLED=true
