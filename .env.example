# ============================================================
# E-Commerce Agents — Environment Configuration
# ============================================================
# Copy to .env and configure your LLM provider:
#   cp .env.example .env
#
# Three LLM providers are supported. Uncomment ONE section below.
# All agents, tools, and embedding generation use the same provider.
# ============================================================


# ── LLM Provider ─────────────────────────────────────────────
# Set to "openai", "azure", or "replay" — controls ALL LLM and embedding calls
LLM_PROVIDER=openai


# ┌────────────────────────────────────────────────────────────┐
# │  OPTION A: OpenAI (or any OpenAI-compatible endpoint)       │
# │  Set LLM_PROVIDER=openai and fill in below                 │
# └────────────────────────────────────────────────────────────┘

OPENAI_API_KEY=sk-your-openai-api-key-here
# Model names date fast. Set this to a current chat model from your provider's
# live list — https://developers.openai.com/api/docs/models — rather than
# treating the value below as a recommendation. It is a known-working floor.
LLM_MODEL=gpt-4.1
EMBEDDING_MODEL=text-embedding-3-small

# Optional: point OpenAIChatClient at an OpenAI-compatible endpoint other
# than api.openai.com — Ollama, OpenRouter, vLLM, LM Studio,
# etc. Only takes effect when LLM_PROVIDER=openai. Leave unset to use OpenAI
# directly.
#
# Ollama is the free path — fully local, zero cost, zero network, no account.
# Start it with a raised context window (the 4K default silently truncates
# agent loops):  OLLAMA_CONTEXT_LENGTH=64000 ollama serve
#   LLM_BASE_URL=http://localhost:11434/v1
#   OPENAI_API_KEY=ollama  (any non-empty string — Ollama doesn't check it)
#   LLM_MODEL=qwen2.5:14b   (see the Gotcha below before picking a model)
#
# LM Studio — same idea, load a model in LM Studio's local server first:
#   LLM_BASE_URL=http://localhost:1234/v1
#   OPENAI_API_KEY=lm-studio  (any non-empty string)
#   LLM_MODEL=<the model identifier shown in LM Studio's server tab>
#
# Gotcha: every specialist agent in this repo is tool-calling-heavy (the
# @tool decorator is how they read the database at all). Many small/
# quantized local models advertise OpenAI-compatible chat completions but
# have unreliable or absent function-calling support — the agent won't
# error, it will just silently stop calling tools and answer from
# (fabricated) memory instead. Measured 2026-08-21 on a 2-tool multi-turn
# loop, qwen2.5:14b, gemma4:12b and qwen3.5:9b all pass. qwen2.5:14b is
# the recommended default: it emits no reasoning trace, so it is ~6x faster
# and cannot spend its whole output budget thinking and return empty content
# than a generic small chat model. If responses stop mentioning real
# product/order data, that's the first thing to check — not a bug in this
# repo's code.
#
# OpenRouter / vLLM: same LLM_BASE_URL mechanism, no code changes needed —
# point it at your OpenRouter base URL or self-hosted vLLM server the same
# way as the examples above.
# LLM_BASE_URL=


# ┌────────────────────────────────────────────────────────────┐
# │  OPTION B: Azure OpenAI                                    │
# │  Set LLM_PROVIDER=azure and fill in below                  │
# └────────────────────────────────────────────────────────────┘

# LLM_PROVIDER=azure
AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_KEY is the repo-native name. AZURE_OPENAI_API_KEY (MAF-docs
# style) is accepted as an alias — set either one.
AZURE_OPENAI_KEY=
# AZURE_OPENAI_DEPLOYMENT is the repo-native name. AZURE_OPENAI_DEPLOYMENT_NAME
# is accepted as an alias.
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_API_VERSION=2025-03-01-preview

# Azure embedding deployment (uses EMBEDDING_MODEL name if not set)
AZURE_EMBEDDING_DEPLOYMENT=


# ┌────────────────────────────────────────────────────────────┐
# │  OPTION C: Replay — no credentials, no network              │
# │  Set LLM_PROVIDER=replay. Plays back recorded fixtures.     │
# │  See shared/replay_client.py / tutorials/_shared/replay_client.py │
# └────────────────────────────────────────────────────────────┘

# LLM_PROVIDER=replay
# Directory of recorded request/response fixtures, keyed by request hash.
# REPLAY_FIXTURES_DIR=tests/fixtures/replay
# Set to true to record a real call (via REPLAY_RECORD_PROVIDER) whenever a
# fixture is missing, instead of raising. Needs real credentials for
# whichever provider REPLAY_RECORD_PROVIDER names.
# RECORD=false
# REPLAY_RECORD_PROVIDER=openai


# ── Database ─────────────────────────────────────────────────
# Use @localhost here. docker-compose.yml hardcodes its own DATABASE_URL
# (with @db) for in-container services, so this value is only consumed
# by host-side scripts: evals, seeders, and local REPL sessions.
POSTGRES_DB=ecommerce_agents
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce_secret
DATABASE_URL=postgresql://ecommerce:ecommerce_secret@localhost:5432/ecommerce_agents


# ── Redis ────────────────────────────────────────────────────
# Same as DATABASE_URL — host-side scripts use localhost, containers use redis.
REDIS_URL=redis://localhost:6379


# ── Auth ─────────────────────────────────────────────────────
# Generate secrets: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-generate-a-random-256-bit-key
AGENT_SHARED_SECRET=agent-internal-shared-secret

# ── OAuth2 (optional; self-hosted, no external IdP) ───────────
# AUTH_MODE=local (default) keeps the JWT_SECRET/AGENT_SHARED_SECRET
# behavior above unchanged. Set AUTH_MODE=oauth to route user login and
# A2A/MCP auth through the self-hosted auth-server instead — start it
# with `docker compose --profile agents up auth-server`. Nothing here
# requires internet access or an account with any identity provider.
AUTH_MODE=local
AUTH_SERVER_ISSUER=http://localhost:8090
AUTH_SERVER_JWKS_URL=http://localhost:8090/.well-known/jwks.json
AUTH_SERVER_TOKEN_URL=http://localhost:8090/oauth/token
AUTH_ACCESS_TOKEN_TTL=3600
AUTH_REFRESH_TOKEN_TTL=604800
AUTH_JWKS_CACHE_TTL=900
AUTH_RSA_KEY_SIZE=2048
# Encrypts the auth-server's private signing key at rest. Required outside
# development when AUTH_MODE=oauth; generate with the command above.
AUTH_SIGNING_KEY_ENCRYPTION_KEY=
# Per-service client identity for the client-credentials grant. Each
# service defaults OAUTH_CLIENT_ID to its own name; leave OAUTH_CLIENT_SECRET
# blank in dev to derive it from OAUTH_SEED_KEY, or set an explicit secret
# per service in production.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_SEED_KEY=dev-oauth-seed-change-me
AUTH_ORCH_AUDIENCE=ecommerce-orchestrator
AUTH_AGENT_AUDIENCE=ecommerce-agents
# Reject (not just log) an inter-agent call whose forwarded X-User-Email/
# X-User-Role headers look spoofed. Checked in both local and oauth modes.
GUARDRAILS_STRICT_IDENTITY=false
# RFC 7591 dynamic client registration (POST /oauth/register), off by
# default — the client registry is otherwise fixed/seeded. Even when true,
# registering still requires a bearer token scoped client:register (see the
# seeded "auth-admin" client in scripts/seed.py).
AUTH_ALLOW_DYNAMIC_REGISTRATION=false
AUTH_SERVER_AUDIENCE=ecommerce-auth-server

# MCP resource-server auth (independent of MCP_ENABLED below).
MCP_AUTH_ENABLED=false
MCP_PRODUCT_AUDIENCE=mcp-product
MCP_INVENTORY_AUDIENCE=mcp-inventory
MCP_PRODUCT_REQUIRED_SCOPE=mcp:product
MCP_INVENTORY_REQUIRED_SCOPE=mcp:inventory
MCP_PRODUCT_RESOURCE_URL=http://mcp-product:9000/mcp
MCP_INVENTORY_RESOURCE_URL=http://mcp-inventory:9001/mcp


# ── Telemetry (OpenTelemetry → .NET Aspire Dashboard) ────────
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://aspire:18889
OTEL_SERVICE_NAME=ecommerce.orchestrator

# ── Langfuse (optional parallel OTel sink) ────────────────────
# Get keys from https://cloud.langfuse.com → Project Settings
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com


# ── MCP Integration (optional) ───────────────────────────────
# Start MCP servers first: docker compose --profile mcp up
# then set MCP_ENABLED=true and restart the specialist agents.
MCP_ENABLED=false
MCP_PRODUCT_SERVER_URL=http://mcp-product:9000/mcp
MCP_INVENTORY_SERVER_URL=http://mcp-inventory:9001/mcp


# ── General ──────────────────────────────────────────────────
ENVIRONMENT=development


# ── Agent Registry ───────────────────────────────────────────
# Internal Docker network URLs for inter-agent A2A communication
AGENT_REGISTRY={"product-discovery":"http://product-discovery:8081","order-management":"http://order-management:8082","pricing-promotions":"http://pricing-promotions:8083","review-sentiment":"http://review-sentiment:8084","inventory-fulfillment":"http://inventory-fulfillment:8085"}


# ── Frontend ─────────────────────────────────────────────────
# Where the frontend's server-side /api/* proxy forwards to. Server-side, not
# NEXT_PUBLIC_*: the browser only ever calls the frontend's own origin, so this
# is read at runtime and never compiled into the bundle. Inside compose that
# makes it a service name; on the host running `pnpm dev` it is localhost.
ORCHESTRATOR_URL=http://localhost:8080


# ── MAF v1 feature flags (optional — safe defaults keep current behavior) ──
# These back the Phase 7 refactor of the live app into MAF-native idioms.
# Uncomment a line only when you want to opt out of the new default.

# MAF_SESSION_BACKEND=postgres     # postgres | file | memory
# MAF_SESSION_DIR=./.sessions
# MAF_CHECKPOINT_BACKEND=postgres  # postgres | file | memory
# MAF_CHECKPOINT_DIR=./.checkpoints
# RETURN_HITL_THRESHOLD=500        # USD above which return/replace pauses for human approval
# HANDOFF_AUTONOMOUS_MODE=true     # true → specialists auto-respond; false → surface handoff events
# HANDOFF_MAX_TURNS=3              # autonomous-mode ceiling for the triage agent. Honoured
#                                  # by both stacks.
#                                  # MAF defaults to 50; that is how a triage agent
#                                  # that cannot hand off produces a 23k-char monologue.
# WORKFLOW_VISUALIZATION_ON_BUILD=false  # true → CI regenerates docs/workflows/*.mmd and fails on drift
